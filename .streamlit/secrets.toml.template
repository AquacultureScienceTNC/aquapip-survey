# ============================================================================
#  AquaPIP — SECRETS TEMPLATE
# ============================================================================
#  Storing survey responses is OPTIONAL. The app works fully without it — the
#  consent box simply has nothing to write to until this is configured.
#
#  To turn on response storage:
#    1. Copy this file to  .streamlit/secrets.toml   (same folder, drop the
#       ".template"). That real file is git-ignored and must NEVER be committed.
#    2. Fill in the values below from your Google Cloud service account
#       (README.md -> "Optional: turn on response storage" walks through it).
#    3. On Streamlit Community Cloud, do NOT upload this file. Instead paste the
#       same contents into  App -> Settings -> Secrets  in the dashboard.
# ----------------------------------------------------------------------------

# The Google Sheet that will receive one row per consenting submission.
# Get the id from the sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_LONG_ID/edit
[responses]
sheet_id = "PASTE_YOUR_GOOGLE_SHEET_ID_HERE"

# Service-account credentials (downloaded as JSON from Google Cloud).
# Copy each field from that JSON. Keep the private_key exactly as-is, including
# the \n line breaks and the triple-quoted block.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = """-----BEGIN PRIVATE KEY-----
PASTE_THE_MULTILINE_PRIVATE_KEY_HERE
-----END PRIVATE KEY-----
"""
client_email = "aquapip-writer@your-project-id.iam.gserviceaccount.com"
client_id = "0000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/aquapip-writer%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
